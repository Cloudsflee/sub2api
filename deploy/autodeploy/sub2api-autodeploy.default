REPO_DIR=/opt/sub2api-custom-src
BUILD_DIR=/opt/sub2api-release
DEPLOY_DIR=/opt/sub2api
COMPOSE_FILE=/opt/sub2api/docker-compose.yml
REMOTE=origin
SOURCE_BRANCH=custom
DEPLOY_BRANCH=deploy/custom
BLUE_SERVICE=sub2api-blue
GREEN_SERVICE=sub2api-green
BLUE_CONTAINER=sub2api-blue
GREEN_CONTAINER=sub2api-green
BLUE_PORT=18080
GREEN_PORT=18081
APP_IMAGE_REPOSITORY=sub2api-custom
WORKER_IMAGE_REPOSITORY=sub2api-product-sync-worker
PROXY_HEALTH_URL=http://127.0.0.1:8080/health
HAPROXY_CONFIG_COMMAND=/usr/local/sbin/sub2api-haproxy-config
HAPROXY_SERVICE=haproxy
HEALTH_TIMEOUT_SECONDS=180
HEALTH_CONSECUTIVE_SUCCESSES=3
STABILITY_SECONDS=30
DRAIN_TIMEOUT_SECONDS=600
WORKER_STABLE_SECONDS=15
BACKUP_BEFORE_DEPLOY=true
BACKUP_COMMAND=/usr/local/sbin/sub2api-backup.sh
MANAGE_WORKER=true
KEEP_IMAGES=4
PRUNE_BUILD_CACHE=true
BUILD_CACHE_MAX_USED_SPACE=6gb
BUILD_CACHE_MIN_FREE_SPACE=8gb
SYNC_REPO_DIR=/opt/sub2api-integration
UPSTREAM_SYNC_REQUEST_FILE=/opt/sub2api/data/upstream-sync-request
UPSTREAM_SYNC_STATUS_FILE=/opt/sub2api/data/upstream-sync-status
UPSTREAM_SYNC_LOCK_FILE=/run/lock/sub2api-upstream-sync.lock
ORIGIN_REMOTE=origin
UPSTREAM_REMOTE=upstream
MAIN_BRANCH=main
