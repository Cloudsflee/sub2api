[Unit]
Description=Build and deploy CI-approved Sub2API custom commits
Wants=network-online.target docker.service
After=network-online.target docker.service
ConditionPathIsDirectory=/opt/sub2api-custom-src
ConditionPathExists=/opt/sub2api/docker-compose.yml

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/sub2api-autodeploy
ExecStart=/usr/local/sbin/sub2api-autodeploy --deploy
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0027
SyslogIdentifier=sub2api-autodeploy
