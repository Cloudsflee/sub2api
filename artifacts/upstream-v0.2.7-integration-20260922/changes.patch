+			case "observe":
+				cfg.Mode = ContentModerationModeObserve
+			case "off":
+				cfg.Mode = ContentModerationModeOff
+			case "disabled":
+				cfg.Enabled = false
+			case "group_scope":
+				cfg.AllGroups = false
